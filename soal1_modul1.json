    {
      "id": 2,
      "type": "input",
      "text": "uang = 200000;\njumlah_buku = 3;\njumlah_pulpen =2;\njumlah_flashdisk = 1",
      "x": 419,
      "y": 126,
      "w": 220,
      "h": 100
    },
    {
      "id": 3,
      "type": "input",
      "text": "harga_buku = 25000;\nharga_pulpen = 8000;\nharga_flashdisk = 75000",
      "x": 397,
      "y": 259,
      "w": 265,
      "h": 145
    },
    {
      "id": 5,
      "type": "process",
      "text": "total_buku = jumlah_buku * harga_buku;\ntotal_pulpen = jumlah_pulpen * harga_pulpen;\ntotal_flashdisk = jumlah_flashdisk * harga_flashdisk",
      "x": 370,
      "y": 489,
      "w": 315,
      "h": 201
    },
    {
      "id": 6,
      "type": "process",
      "text": "total_belanja = total_buku + total_pulpen + total_flashdisk",
      "x": 416,
      "y": 782,
      "w": 225,
      "h": 111
    },
    {
      "id": 8,
      "type": "process",
      "text": "besar_diskon = total_belanja * 0.10",
      "x": 439,
      "y": 960,
      "w": 180,
      "h": 66
    },
    {
      "id": 9,
      "type": "process",
      "text": "setelah_diskon = total_belanja - besar_diskon",
      "x": 438,
      "y": 1066,
      "w": 180,
      "h": 66
    },
    {
      "id": 10,
      "type": "process",
      "text": "besar_ppn = setelah_diskon * 0.11",
      "x": 438,
      "y": 1184,
      "w": 180,
      "h": 66
    },
    {
      "id": 11,
      "type": "process",
      "text": "total_bayar = setelah_diskon  + besar_ppn",
      "x": 438,
      "y": 1301,
      "w": 180,
      "h": 66
    },
    {
      "id": 12,
      "type": "process",
      "text": "kembalian = uang - total_bayar",
      "x": 438,
      "y": 1431,
      "w": 180,
      "h": 66
    },
    {
      "id": 13,
      "type": "output",
      "text": "\"Total Harga Buku\", total_buku; \n\"Total  Harga Pulpen\", total_pulpen;\n\"Total   Harga Flashdisk\", total_flashdisk;\n\"Total Harga Sebelum Diskon\", total_belanja;\n\"Harga Barang setelah diskon\", setelah_diskon; \n\"Total Pembayaran Setelah Pajak\", total_bayar; \n\"Uang Kembalian\", kembalian",
      "x": 387,
      "y": 1540,
      "w": 280,
      "h": 160
    },
